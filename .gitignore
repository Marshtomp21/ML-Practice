# ---- 数据：原始影像一律不入库（体积 + 许可限制）----
data/raw/**
data/processed/**
data/external/**
!data/**/.gitkeep

# 划分清单必须入库：它是可复现性的核心，且体积很小
!data/splits/**

# 课程数据归档仅用于本地解压，禁止误提交大文件
/ML-models_datasets.7z

# ---- 模型权重 ----
models/checkpoints/
*.pt
*.pth

# ---- 结果：大文件不入库，结构化指标与图表入库 ----
results/attributions/**
results/.cache/**
results/logs/**
!results/**/.gitkeep
# 指标 / 表格 / 图表入库，供报告与答辩直接引用
!results/metrics/**
!results/tables/**
!results/figures/**

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# ---- LaTeX ----
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls
*.thm
*.xdv
reports/**/*.pdf
!reports/**/figures/*.pdf
# 例外：该图内嵌 ILSVRC2012 与 CHNCXR 原图，入库等同再分发，
# 故只提交生成脚本 scripts/m1/fig2_slic_overlay.py，图本身各人本地生成
reports/**/figures/m1_slic_overlay.png

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
