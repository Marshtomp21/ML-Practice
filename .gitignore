# ---- 数据：原始影像一律不入库（体积 + 许可限制）----
data/raw/**
data/processed/**
data/external/**
!data/**/.gitkeep

# 划分清单必须入库：它是可复现性的核心，且体积很小
!data/splits/**
# 本机同步前备份与已被全量运行取代的首轮试跑不入库
data/splits/*.local-*
data/splits/chncxr_pilot_20260910/
data/splits/m3_*_shard*/

# 课程数据归档仅用于本地解压，禁止误提交大文件
/ML-models_datasets.7z

# ---- 模型权重 ----
models/checkpoints/
*.pt
*.pth

# ---- 结果：大文件不入库，结构化指标与图表入库 ----
results/attributions/**
results/.cache/**
results/logs/**
!results/**/.gitkeep
# 指标 / 表格 / 图表入库，供报告与答辩直接引用
!results/metrics/**
!results/tables/**
!results/figures/**
results/metrics/chncxr_pilot_20260910/
# M3 GPU 分片是可恢复的运行中间件；只提交合并后的统一结果
results/metrics/m3_*_shard*/

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
.venv-experiments/
venv/

# ---- LaTeX ----
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls
*.thm
*.xdv
reports/**/*.pdf
!reports/**/figures/*.pdf
# 历史原图拼图已停用；仍忽略可能遗留的本地副本，避免再分发原始影像
reports/**/figures/m1_slic_overlay.png

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
